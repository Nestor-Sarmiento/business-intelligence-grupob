    <entry>
      <name>10 - Validar Carga DW</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DO $$
BEGIN

    -- Verificar que las fuentes no estén vacías
    IF NOT EXISTS (SELECT 1 FROM staging.clientes)
       OR NOT EXISTS (SELECT 1 FROM staging.facturacion)
       OR NOT EXISTS (SELECT 1 FROM staging.dispositivos) THEN
        RAISE EXCEPTION 'Una fuente de staging está vacía';
    END IF;

    -- Validar dimensión fecha
    IF (SELECT COUNT(*) FROM staging.v_carga_dim_fecha)
       &lt;&gt; (SELECT COUNT(*) FROM dw.dim_fecha) THEN
        RAISE EXCEPTION 'Error en dim_fecha';
    END IF;

    -- Validar dimensión cliente
    IF (SELECT COUNT(*) FROM staging.v_carga_dim_cliente)
       &lt;&gt; (SELECT COUNT(*) FROM dw.dim_cliente) THEN
        RAISE EXCEPTION 'Error en dim_cliente';
    END IF;

    -- Validar dimensión dispositivo
    IF (SELECT COUNT(*) FROM staging.v_carga_dim_dispositivo)
       &lt;&gt; (SELECT COUNT(*) FROM dw.dim_dispositivo) THEN
        RAISE EXCEPTION 'Error en dim_dispositivo';
    END IF;

    -- Validar dimensión grupo
    IF (SELECT COUNT(*) FROM staging.v_carga_dim_grupo)
       &lt;&gt; (SELECT COUNT(*) FROM dw.dim_grupo) THEN
        RAISE EXCEPTION 'Error en dim_grupo';
    END IF;

    -- Validar cantidad de facturas
    IF NOT EXISTS (SELECT 1 FROM staging.v_factura_limpia)
       OR (SELECT COUNT(*) FROM staging.v_factura_limpia)
       &lt;&gt; (SELECT COUNT(*) FROM dw.fact_facturacion) THEN
        RAISE EXCEPTION 'Error en fact_facturacion';
    END IF;

    -- Validar importe total de facturación
    IF (SELECT SUM(valor_facturado)
        FROM staging.v_factura_limpia)
        IS DISTINCT FROM
       (SELECT SUM(valor_facturado)
        FROM dw.fact_facturacion) THEN
        RAISE EXCEPTION 'Diferencia en total facturado';
    END IF;

    -- Validar registros GPS del reporte actual
    IF (SELECT COUNT(*)
        FROM staging.v_gps_limpio
        WHERE nombre_dispositivo IS NOT NULL)
       &lt;&gt; (
           SELECT COUNT(*)
           FROM dw.fact_estado_gps f
           JOIN dw.dim_fecha d
               ON d.fecha_sk = f.fecha_reporte_sk
           JOIN staging.v_config_reporte c
               ON c.fecha_reporte = d.fecha
       ) THEN
        RAISE EXCEPTION 'Error en fact_estado_gps';
    END IF;

    -- Validar antigüedad de registros GPS
    IF EXISTS (
        SELECT 1
        FROM dw.fact_estado_gps f
        JOIN dw.dim_fecha d
            ON d.fecha_sk = f.fecha_reporte_sk
        LEFT JOIN dw.dim_fecha u
            ON u.fecha_sk = f.fecha_registro_sk
        WHERE f.estado_datos = 'CON_DATOS'
          AND (
              u.fecha IS NULL
              OR f.dias_sin_registro
                 IS DISTINCT FROM d.fecha - u.fecha
          )
    ) THEN
        RAISE EXCEPTION 'Inconsistencia en fechas GPS';
    END IF;

    RAISE NOTICE 'Validaciones completadas correctamente';

END;
$$;</sql>
