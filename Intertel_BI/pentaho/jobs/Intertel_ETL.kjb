    <entry>
      <name>11 - Registrar Exito ETL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>WITH ejecucion AS (
    UPDATE audit.ejecucion_etl
    SET
        fin = NOW(),
        estado = 'EXITOSO',
        observacion = 'ETL ejecutado y validado correctamente'
    WHERE ejecucion_sk = (
        SELECT MAX(ejecucion_sk)
        FROM audit.ejecucion_etl
        WHERE estado = 'EN_PROCESO'
    )
    RETURNING ejecucion_sk
)
INSERT INTO audit.incidencia_etl (
    ejecucion_sk,
    fuente,
    fila_origen,
    regla,
    severidad
)
SELECT
    e.ejecucion_sk,
    i.fuente,
    i.fila_origen,
    i.regla,
    i.severidad
FROM staging.v_incidencias i
CROSS JOIN ejecucion e;</sql>
