  <step>
    <name>Validar Fechas</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
function dos(n) {
    return n &lt; 10 ? "0" + n : "" + n;
}

function validarFecha(a, m, d) {
    a = Number(a);
    m = Number(m);
    d = Number(d);

    if (a &lt; 1900 || a > 2100 ||
        m &lt; 1 || m > 12 ||
        d &lt; 1 || d > 31) {
        return null;
    }

    var f = new Date(Date.UTC(a, m - 1, d));

    if (f.getUTCFullYear() != a ||
        f.getUTCMonth() + 1 != m ||
        f.getUTCDate() != d) {
        return null;
    }

    return a + "-" + dos(m) + "-" + dos(d);
}

function convertirFecha(valor) {
    if (valor == null) return null;

    // 1. Fechas como objetos Date de Java o JavaScript
    try {
        if (typeof valor.getTime == "function") {
            var ms = Number(valor.getTime());

            if (!isNaN(ms)) {
                var cal = java.util.Calendar.getInstance();
                cal.setTimeInMillis(ms);

                return validarFecha(
                    cal.get(java.util.Calendar.YEAR),
                    cal.get(java.util.Calendar.MONTH) + 1,
                    cal.get(java.util.Calendar.DAY_OF_MONTH)
                );
            }
        }
    } catch (e) {}

    var s = String(valor).trim();

    if (s.length == 0) return null;

    // 2. Formatos yyyy-MM-dd o yyyy/MM/dd
    // Incluye fechas con hora y milisegundos
    var p = /(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/.exec(s);

    if (p != null) {
        return validarFecha(p[1], p[2], p[3]);
    }

    // 3. Formato dd/MM/yyyy
    // También acepta caracteres extra al inicio
    p = /(\d{1,2})\/(\d{1,2})\/(\d{4})/.exec(s);

    if (p != null) {
        return validarFecha(p[3], p[2], p[1]);
    }

    // 4. Números de serie de Excel
    // Ejemplo: 40179 o 40179.0
    if (/^\d{4,6}(\.0+)?$/.test(s)) {
        var dias = Number(s);

        var fExcel = new Date(
            Date.UTC(1899, 11, 30) +
            dias * 86400000
        );

        return validarFecha(
            fExcel.getUTCFullYear(),
            fExcel.getUTCMonth() + 1,
            fExcel.getUTCDate()
        );
    }

    // 5. Fechas Java como:
    // Fri Jan 01 00:00:00 ECT 2010
    var meses = {
        Jan: 1, Feb: 2, Mar: 3,
        Apr: 4, May: 5, Jun: 6,
        Jul: 7, Aug: 8, Sep: 9,
        Oct: 10, Nov: 11, Dec: 12
    };

    p = /([A-Za-z]{3})\s+(\d{1,2})\s+\d{1,2}:\d{2}:\d{2}\s+\S+\s+(\d{4})/.exec(s);

    if (p != null &amp;&amp; meses[p[1]] != null) {
        return validarFecha(
            p[3],
            meses[p[1]],
            p[2]
        );
    }

    return null;
}

// Resultados
var fecha_admision_std = convertirFecha(fecha_admision);
var fecha_estado_std = convertirFecha(fecha_estado);

var fechas_validas = (
    fecha_admision_std != null &amp;&amp;
    fecha_estado_std != null &amp;&amp;
    fecha_estado_std >= fecha_admision_std
);
</jsScript_script>
      </jsScript>
    </jsScripts>
