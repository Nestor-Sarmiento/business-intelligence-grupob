    </partitioning>
    <compatible>Y</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
var equivalencias = {
    // APELLIDOS
    "alarc#n": "Alarcón",
    "mu#oz": "Muñoz",
    "pe#a": "Peña",
    "n#ñez": "Núñez",
    "p#rez": "Pérez",
    "l#pez": "López",
    "garc#a": "García",
    "mart#nez": "Martínez",
    "hern#ndez": "Hernández",
    "rodr#guez": "Rodríguez",
    "gonz#lez": "González",
    "ram#rez": "Ramírez",
    "s#nchez": "Sánchez",
    "d#az": "Díaz",
    "su#rez": "Suárez",
    "v#squez": "Vásquez",
    "ib#ñez": "Ibáñez",
    "ni#o": "Niño",
    "ben#tez": "Benítez",
    "cort#s": "Cortés",
    "guti#rrez": "Gutiérrez",

    // NOMBRES
    "jos#": "José",
    "in#s": "Inés",
    "ren#": "René",
    "mar#a": "María",
    "sof#a": "Sofía",
    "luc#a": "Lucía",
    "m#nica": "Mónica",
    "c#sar": "César",
    "andr#s": "Andrés",
    "jes#s": "Jesús",
    "nicol#s": "Nicolás",
    "bel#n": "Belén",
    "ra#l": "Raúl",
    "ang#l": "Ángel",
    "h#ctor": "Héctor",
    "juli#n": "Julián",
    "sebasti#n": "Sebastián",
    "adri#n": "Adrián"
};

// Convertir simbolos desconocidos en #
function claveDe(palabra) {
    var texto = String(palabra).toLowerCase();
    var clave = "";
    var habiaSimbolo = false;

    for (var i = 0; i &lt; texto.length; i++) {
        var c = texto.charAt(i);
        var numero = texto.charCodeAt(i);

        var letra =
            (numero >= 97 &amp;&amp; numero &lt;= 122) ||
            (numero >= 192 &amp;&amp; numero &lt;= 383);

        if (letra) {
            clave += c;
            habiaSimbolo = false;
        } else if (c == "-" || c == "'") {
            clave += c;
            habiaSimbolo = false;
        } else if (!habiaSimbolo) {
            clave += "#";
            habiaSimbolo = true;
        }
    }

    return clave;
}

// Convertir a mayuscula inicial
function titulo(palabra) {
    var s = String(palabra).toLowerCase();

    if (s.length == 0) return "";

    return s.charAt(0).toUpperCase() +
           s.substring(1);
}

// Limpiar nombre o apellido completo
function limpiarTexto(valor) {
    if (valor == null) return "";

    var s = String(valor);
    var palabras = [];
    var actual = "";

    // Separar palabras sin expresiones regulares
    for (var i = 0; i &lt; s.length; i++) {
        var codigo = s.charCodeAt(i);

        var esEspacio =
            codigo == 32 ||
            codigo == 9 ||
            codigo == 10 ||
            codigo == 13 ||
            codigo == 160;

        if (esEspacio) {
            if (actual.length > 0) {
                palabras.push(actual);
                actual = "";
            }
        } else {
            actual += s.charAt(i);
        }
    }

    if (actual.length > 0) {
        palabras.push(actual);
    }

    // Aplicar diccionario
    var resultado = [];

    for (var j = 0; j &lt; palabras.length; j++) {
        var clave = claveDe(palabras[j]);
        var corregida = equivalencias[clave];

        if (corregida == null) {
            corregida = titulo(palabras[j]);
        }

        // Conectores en minusculas
        var minuscula = String(corregida).toLowerCase();

        if (j > 0 &amp;&amp;
            (minuscula == "de" ||
             minuscula == "del" ||
             minuscula == "la" ||
             minuscula == "las" ||
             minuscula == "los" ||
             minuscula == "y")) {
            corregida = minuscula;
        }

        resultado.push(corregida);
    }

    return resultado.join(" ");
}

// CAMPOS DE SALIDA
var nombres_limpios = limpiarTexto(nombres);
var apellidos_limpios = limpiarTexto(apellidos);
</jsScript_script>
